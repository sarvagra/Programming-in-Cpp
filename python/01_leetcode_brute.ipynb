   "source": [
    "\n",
    "def twosum(nums: list, target: int):\n",
    "    n=len(nums)\n",
    "    for i in range(n):\n",
    "        for j in range(n):\n",
    "            if(i!=j):\n",
    "                if(nums[i]+nums[j]==target):\n",
    "                    return [i,j]\n",
    "         \n",
    "               "
   ]
  },
